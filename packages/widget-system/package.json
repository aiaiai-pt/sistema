{
  "name": "@aiaiai-pt/widget-system",
  "version": "0.2.1",
  "description": "Generic widget registry, dispatch, display transforms, and transport-neutral widgets for aiaiai products",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiaiai-pt/sistema.git",
    "directory": "packages/widget-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "svelte": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./widgets": {
      "types": "./src/widgets/index.ts",
      "svelte": "./src/widgets/index.ts",
      "default": "./src/widgets/index.ts"
    },
    "./widgets/EntryStreamWidget": {
      "types": "./src/widgets/EntryStreamWidget.svelte",
      "svelte": "./src/widgets/EntryStreamWidget.svelte",
      "default": "./src/widgets/EntryStreamWidget.svelte"
    },
    "./widgets/IndicatorCardWidget": {
      "types": "./src/widgets/IndicatorCardWidget.svelte",
      "svelte": "./src/widgets/IndicatorCardWidget.svelte",
      "default": "./src/widgets/IndicatorCardWidget.svelte"
    },
    "./widgets/DefinitionMembersCardWidget": {
      "types": "./src/widgets/DefinitionMembersCardWidget.svelte",
      "svelte": "./src/widgets/DefinitionMembersCardWidget.svelte",
      "default": "./src/widgets/DefinitionMembersCardWidget.svelte"
    },
    "./widgets/ChartTileMockWidget": {
      "types": "./src/widgets/ChartTileMockWidget.svelte",
      "svelte": "./src/widgets/ChartTileMockWidget.svelte",
      "default": "./src/widgets/ChartTileMockWidget.svelte"
    },
    "./widgets/NativeChartWidget": {
      "types": "./src/widgets/NativeChartWidget.svelte",
      "svelte": "./src/widgets/NativeChartWidget.svelte",
      "default": "./src/widgets/NativeChartWidget.svelte"
    },
    "./widgets/EmbeddedAnalysisWidget": {
      "types": "./src/widgets/EmbeddedAnalysisWidget.svelte",
      "svelte": "./src/widgets/EmbeddedAnalysisWidget.svelte",
      "default": "./src/widgets/EmbeddedAnalysisWidget.svelte"
    },
    "./widgets/embed-url": {
      "types": "./src/widgets/embed-url.ts",
      "default": "./src/widgets/embed-url.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "default": "./src/fixtures/index.ts"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "echarts": "^6.1.0",
    "@aiaiai-pt/design-system": ">=0.51.0 <1"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "@aiaiai-pt/design-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aiaiai-pt/design-system": "file:../..",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "echarts": "^6.1.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.55.3",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
